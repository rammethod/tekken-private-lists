{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isBoolean()"
      }
    },
    "access": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || newData.isBoolean()"
      }
    },
    "pendingAccess": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid && root.child('access').child(auth.uid).val() !== true) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "!newData.exists() || newData.hasChildren(['email', 'requestedAt'])"
      }
    },
    "accountUsers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "lastLoginAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          "displayName": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "photoURL": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "lastLoginAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "lists": {
          "$listId": {
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "order": { ".validate": "newData.isNumber()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "awardEnabled": { ".validate": "!newData.exists() || newData.isBoolean()" },
            "shareId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 16 && newData.val().length <= 64)" },
            "sharedCreatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "last_update_log": {
              ".validate": "!newData.exists() || (newData.hasChildren(['timestamp', 'type', 'formattedTime', 'displayText']) && newData.child('timestamp').isNumber() && newData.child('type').isString() && newData.child('formattedTime').isString() && newData.child('displayText').isString())",
              "timestamp": { ".validate": "newData.isNumber()" },
              "type": { ".validate": "newData.isString() && (newData.val() === 'manual' || newData.val() === 'auto')" },
              "targetName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 50)" },
              "formattedTime": { ".validate": "newData.isString() && newData.val().length <= 30" },
              "displayText": { ".validate": "newData.isString() && newData.val().length <= 150" },
              "$other": { ".validate": false }
            },
            "memberSort": {
              ".validate": "!newData.exists() || (newData.hasChildren(['mode', 'direction']) && newData.child('mode').isString() && newData.child('direction').isString())",
              "mode": { ".validate": "newData.isString() && (newData.val() === 'manual' || newData.val() === 'name' || newData.val() === 'rank' || newData.val() === 'games' || newData.val() === 'rating' || newData.val() === 'winrate' || newData.val() === 'power' || newData.val() === 'last_active' || newData.val() === 'pentagon_attack' || newData.val() === 'pentagon_technique' || newData.val() === 'pentagon_appeal' || newData.val() === 'pentagon_spirit' || newData.val() === 'pentagon_defense')" },
              "direction": { ".validate": "newData.isString() && (newData.val() === 'asc' || newData.val() === 'desc')" },
              "excludeHistorical": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            },
            "members": {
              "$memberId": {
                "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
                "autoName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 50)" },
                "nameMode": { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'manual' || newData.val() === 'auto'))" },
                "nameSource": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
                "nameUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
                "autoNameUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
                "gameId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
                "subtitle": { ".validate": "!newData.exists() || newData.isString()" },
                "xUrl": { ".validate": "!newData.exists() || newData.isString()" },
                "countryCode": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2)" },
                "photoData": { ".validate": "!newData.exists() || newData.isString()" },
                "color": { ".validate": "!newData.exists() || newData.isString()" },
                "order": { ".validate": "!newData.exists() || newData.isNumber()" },
                "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
                "fetchedStats": { ".validate": "!newData.exists() || newData.hasChildren()" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "listIndex": {
          "$listId": {
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "order": { ".validate": "newData.isNumber()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "memberCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "shareId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 16 && newData.val().length <= 64)" },
            "sharedCreatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "isFavorite": { ".validate": "!newData.exists() || newData.isBoolean()" },
            "awardEnabled": { ".validate": "!newData.exists() || newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "awardSchedules": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$listId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['enabled', 'updatedAt']) && newData.child('enabled').isBoolean() && newData.child('updatedAt').isNumber())",
          "enabled": { ".validate": "newData.isBoolean()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "resetRequestedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "awardRuns": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },
    "automationStatus": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "backgroundSyncState": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "sharedListAccess": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "sharedLists": {
      "$shareId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || newData.hasChildren(['ownerUid', 'name', 'members', 'createdAt', 'updatedAt'])",
        "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "members": {
          "$memberId": {
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
            "autoName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length > 0 && newData.val().length <= 50)" },
            "nameMode": { ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'manual' || newData.val() === 'auto'))" },
            "nameSource": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
            "nameUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "autoNameUpdatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "gameId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "subtitle": { ".validate": "!newData.exists() || newData.isString()" },
            "xUrl": { ".validate": "!newData.exists() || newData.isString()" },
            "countryCode": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2)" },
            "photoData": { ".validate": "!newData.exists() || newData.isString()" },
            "color": { ".validate": "!newData.exists() || newData.isString()" },
            "order": { ".validate": "!newData.exists() || newData.isNumber()" },
            "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
            "fetchedStats": { ".validate": "!newData.exists() || newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}

