{
  "name": "tekken-private-lists",
  "private": true,
  "scripts": {
    "check": "node tools/check-repo.mjs",
    "test:freshness": "node --test tests/stats-freshness.test.mjs",
    "test:stats": "node --test tests/stats-freshness.test.mjs tests/stats-persistence.test.mjs tests/live-sort-medal-sync.test.mjs tests/ewgf-profile-html.test.mjs",
    "test:scheduled": "node --test tests/scheduled-token-reuse.test.mjs tests/scheduled-checkpoints.test.mjs",
    "bench:scheduled-checkpoints": "node --expose-gc tools/benchmark-scheduled-checkpoints.mjs",
    "inspect:worker": "node tools/inspect-worker.mjs",
    "deploy:worker": "node tools/deploy-worker.mjs",
    "deploy:rules": "node tools/deploy-rules.mjs"
  },
  "devDependencies": {
    "firebase-tools": "15.28.1",
    "wrangler": "4.125.0"
  }
}
